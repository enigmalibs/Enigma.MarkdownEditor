<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mirrors the single TFM of the project under test (Enigma.MarkdownEditor.Core, net10.0). -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Enigma.MarkdownEditor.Core/Enigma.MarkdownEditor.Core.csproj" />
  </ItemGroup>
  <!-- The template's fixture copy-glob ItemGroup is deliberately omitted: this suite loads no
       fixture files by relative path. Add it back (with only the extensions actually used) if it
       ever does. -->
</Project>
