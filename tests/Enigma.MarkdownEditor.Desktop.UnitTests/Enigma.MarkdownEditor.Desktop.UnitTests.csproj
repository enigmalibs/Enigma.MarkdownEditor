<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mirrors the single TFM of the project under test (Enigma.MarkdownEditor.Desktop, net10.0). -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <!-- The headless harness. Avalonia.Headless supplies a windowing and drawing platform with no
         screen behind it; Avalonia.Headless.XUnit supplies [AvaloniaFact]/[AvaloniaTheory], which run
         a test body on that platform's own UI thread. Part of the version-coupled Avalonia set
         (12.1.2): bump them with the rest of it, never alone. -->
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Enigma.MarkdownEditor.Desktop/Enigma.MarkdownEditor.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The markdown corpus the renderer tests parse, and the visual checklist a manual pass walks.
         Markdown only: nothing else in this suite is loaded by relative path. -->
    <None Include="Fixtures/**/*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
