<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Enigma.MarkdownEditor.Desktop.ViewModels"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             x:Class="Enigma.MarkdownEditor.Desktop.Views.WorkspaceManagerView"
             x:DataType="vm:WorkspaceManagerViewModel"
             Width="700" Height="420">

  <UserControl.Styles>
    <!-- Column caption above a list. -->
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundSecondaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.rowTitle">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.rowDetail">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundSecondaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- A folder that is not on disk right now: shown, greyed, never dropped. -->
    <Style Selector="TextBlock.missing">
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundTertiaryBrush}" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource EnigmaErrorBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto" ColumnDefinitions="230,Auto,*">

    <!-- ===================== The workspaces themselves ===================== -->
    <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,*,Auto">
      <TextBlock Grid.Row="0" Classes="caption" Text="WORKSPACES" />

      <ListBox Grid.Row="1"
               ItemsSource="{Binding Workspaces}"
               SelectedItem="{Binding SelectedWorkspace}"
               Background="{DynamicResource EnigmaSurfaceBrush}"
               BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
               BorderThickness="1">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:WorkspaceListItem">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
              <ei:Icon Grid.Row="0" Grid.Column="0"
                       Kind="Check"
                       Size="12"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsActive}"
                       ToolTip.Tip="The workspace that is open" />
              <TextBlock Grid.Row="0" Grid.Column="1" Classes="rowTitle" Text="{Binding Name}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="rowDetail" Text="{Binding Summary}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
        <Button Classes="action"
                Command="{Binding AddWorkspaceCommand}"
                ToolTip.Tip="Pick a folder; the workspace is named after it">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ei:Icon Kind="FolderPlus" Size="14" VerticalAlignment="Center" />
            <TextBlock Text="New workspace…" />
          </StackPanel>
        </Button>
        <Button Classes="action"
                Command="{Binding BeginRemoveWorkspaceCommand}"
                IsEnabled="{Binding HasSelection}"
                ToolTip.Tip="Remove the selected workspace from the list">
          <ei:Icon Kind="Trash" Size="14" />
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="0" Grid.Column="1"
            Width="1"
            Margin="14,0"
            Background="{DynamicResource EnigmaBorderSubtleBrush}" />

    <!-- ======================= The selected workspace ======================= -->
    <Grid Grid.Row="0" Grid.Column="2"
          RowDefinitions="Auto,Auto,Auto,Auto,*"
          IsVisible="{Binding HasSelection}">

      <TextBlock Grid.Row="0" Classes="caption" Text="NAME" />

      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
        <TextBox Grid.Column="0"
                 Text="{Binding EditedName}"
                 PlaceholderText="Workspace name"
                 MaxLength="60" />
        <Button Grid.Column="1"
                Margin="6,0,0,0"
                Padding="10,5"
                Command="{Binding RenameWorkspaceCommand}"
                IsEnabled="{Binding CanRename}"
                ToolTip.Tip="Apply the new name">
          <ei:Icon Kind="PencilSimple" Size="14" />
        </Button>
      </Grid>

      <TextBlock Grid.Row="2"
                 Classes="error"
                 Margin="0,0,0,10"
                 IsVisible="{Binding HasNameError}"
                 Text="{Binding NameError}" />

      <TextBlock Grid.Row="3" Classes="caption" Margin="0,6,0,6" Text="FOLDERS" />

      <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
        <ListBox Grid.Column="0"
                 ItemsSource="{Binding Roots}"
                 SelectedItem="{Binding SelectedRoot}"
                 Background="{DynamicResource EnigmaSurfaceBrush}"
                 BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
                 BorderThickness="1">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:WorkspaceRootItem">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ToolTip.Tip="{Binding Tooltip}">
                <ei:Icon Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                         Kind="Folder"
                         Size="14"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         IsVisible="{Binding !IsMissing}" />
                <ei:Icon Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                         Kind="Warning"
                         Size="14"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource EnigmaWarningBrush}"
                         IsVisible="{Binding IsMissing}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="rowTitle" Text="{Binding Name}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="rowDetail" Text="{Binding Path}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="6" Width="120">
          <Button Classes="action"
                  Command="{Binding AddRootCommand}"
                  ToolTip.Tip="Add another folder to this workspace">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ei:Icon Kind="Plus" Size="14" VerticalAlignment="Center" />
              <TextBlock Text="Add folder…" />
            </StackPanel>
          </Button>
          <Button Classes="action"
                  Command="{Binding RemoveRootCommand}"
                  IsEnabled="{Binding CanRemoveRoot}"
                  ToolTip.Tip="A workspace keeps at least one folder">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ei:Icon Kind="Trash" Size="14" VerticalAlignment="Center" />
              <TextBlock Text="Remove" />
            </StackPanel>
          </Button>
          <Button Classes="action"
                  Command="{Binding MoveRootUpCommand}"
                  IsEnabled="{Binding CanMoveRootUp}"
                  ToolTip.Tip="The tree lists the folders in this order">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ei:Icon Kind="ArrowUp" Size="14" VerticalAlignment="Center" />
              <TextBlock Text="Move up" />
            </StackPanel>
          </Button>
          <Button Classes="action"
                  Command="{Binding MoveRootDownCommand}"
                  IsEnabled="{Binding CanMoveRootDown}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ei:Icon Kind="ArrowDown" Size="14" VerticalAlignment="Center" />
              <TextBlock Text="Move down" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Nothing selected, which on a fresh install means nothing exists yet. -->
    <StackPanel Grid.Row="0" Grid.Column="2"
                Spacing="10"
                VerticalAlignment="Center"
                IsVisible="{Binding !HasSelection}">
      <ei:Icon Kind="Books" Size="28" HorizontalAlignment="Center"
               Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}" />
      <TextBlock TextAlignment="Center"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}"
                 Text="A workspace is a name and the folders it opens. Create one, then add as many folders as you like." />
    </StackPanel>

    <!-- ===== Inline bars: this dialog is itself the application's one ContentDialog, so a
         confirmation cannot be raised on top of it — it is asked here instead. ===== -->
    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Spacing="8" Margin="0,12,0,0">
      <Border IsVisible="{Binding IsRemoveConfirmationVisible}"
              Background="{DynamicResource EnigmaWarningBackgroundBrush}"
              BorderBrush="{DynamicResource EnigmaWarningBorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="12,8">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <ei:Icon Grid.Column="0" Kind="Warning" Size="16" Margin="0,0,10,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Text="{Binding RemoveConfirmationText}" />
          <Button Grid.Column="2"
                  Margin="10,0,6,0"
                  Padding="12,4"
                  Command="{Binding RemoveWorkspaceCommand}"
                  Content="Remove" />
          <Button Grid.Column="3"
                  Padding="12,4"
                  Command="{Binding CancelRemoveWorkspaceCommand}"
                  Content="Cancel" />
        </Grid>
      </Border>

      <Border IsVisible="{Binding HasError}"
              Background="{DynamicResource EnigmaErrorBackgroundBrush}"
              BorderBrush="{DynamicResource EnigmaErrorBorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="12,8">
        <Grid ColumnDefinitions="Auto,*">
          <ei:Icon Grid.Column="0" Kind="WarningCircle" Size="16" Margin="0,0,10,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Text="{Binding ErrorMessage}" />
        </Grid>
      </Border>
    </StackPanel>

  </Grid>
</UserControl>
