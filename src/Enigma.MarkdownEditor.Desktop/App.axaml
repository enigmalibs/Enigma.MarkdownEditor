<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Enigma.MarkdownEditor.Desktop.App">

  <!-- FluentTheme must stay: Enigma.Avalonia.Desktop declares ControlThemes only for its own
       controls, so without it every framework control - including those nested inside the Enigma
       templates - loses its template. -->
  <Application.Styles>
    <FluentTheme />
    <!-- AvaloniaEdit ships its control theme separately from the assembly's default styles: without
         this include the TextEditor in the editor pane renders as an untemplated blank. It has to
         come after FluentTheme, whose ScrollViewer/ScrollBar themes it builds on. -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
  </Application.Styles>

  <!-- The Enigma theme is a ResourceDictionary, so it is merged as a ResourceInclude into
       Application.Resources. A StyleInclude here fails the build with AVLN2000.
       Any dictionary of our own that overrides an Enigma* key must be merged AFTER this one.
       RequestedThemeVariant is deliberately unset here: App assigns it from the persisted Theme
       setting before the main window is built, and IThemeService assigns it again
       whenever the setting changes. Declaring a variant in markup would only be overwritten a
       moment later. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Enigma.Avalonia.Desktop/Themes/Fluent.axaml" />
        <!-- After the Enigma dictionary, per the rule above. This one adds a key rather than
             overriding one, so the order costs nothing today - but it is where an override would
             go, and a dictionary that has to be second is not one to leave sitting first.
             HeadlessTestApp merges the same two, in the same order, so the test suite resolves the
             palette this application actually has. -->
        <ResourceInclude Source="avares://Enigma.MarkdownEditor.Desktop/Themes/PreviewBrushes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
